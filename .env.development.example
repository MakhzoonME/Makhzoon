# =============================================================================
# DEVELOPMENT ENVIRONMENT (dev branch -> dev.makhzoon.me)
# =============================================================================
# Paste this into Vercel:
#   Project: makhzoon-dev
#   Settings -> Environment Variables -> Import .env -> select "Development"
#     and "Preview" scopes (NOT Production)
# Fill in the blanks before importing.
# =============================================================================

# --- Firebase Client (public, safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=***REMOVED-LEAKED-FIREBASE-SECRET***
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=makhzoonme-dev-b72a5.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=makhzoonme-dev-b72a5
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=makhzoonme-dev-b72a5.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1052933531021
NEXT_PUBLIC_FIREBASE_APP_ID=1:1052933531021:web:3ec8914c1124bfde7dc9c4
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-QXHFBCZNVN

# --- Firebase Admin (server-side only, NEVER expose to client) ---
# From Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=makhzoonme-dev-b72a5
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@makhzoonme-dev-b72a5.iam.gserviceaccount.com
# Paste full key including BEGIN/END lines, keep \n as literal escapes, wrap in quotes
FIREBASE_PRIVATE_KEY="***REMOVED-LEAKED-FIREBASE-SECRET***"

# --- Supabase (public, safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Admin (server-side only, NEVER expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- App Config ---
NEXT_PUBLIC_APP_URL=https://dev.makhzoon.me
NODE_ENV=development
# Explicit environment identifier. Values: development | staging | production
# Do NOT rely on NODE_ENV — Vercel sets NODE_ENV=production for Preview and Production.
NEXT_PUBLIC_APP_ENV=development

# --- Email (Resend) ---
# Use a separate Resend API key for dev so you don't pollute prod analytics
RESEND_API_KEY=
RESEND_FROM_EMAIL=Makhzoon Dev <dev-notifications@makhzoon.me>

# --- Cron ---
# Generate with: openssl rand -hex 32
CRON_SECRET=

