# =============================================================================
# PRODUCTION ENVIRONMENT (main branch -> makhzoon.me)
# =============================================================================
# Paste this into Vercel:
#   Project: makhzoon-prod (or makhzoon)
#   Settings -> Environment Variables -> Import .env -> select "Production"
#     scope only
# Fill in the blanks before importing.
#
# WARNING: These values touch real customer data. Treat the filled-in version
# as a secret. Store it in a password manager, NOT a chat or repo.
# =============================================================================

# --- Supabase (public, safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Admin (server-side only, NEVER expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- App Config ---
NEXT_PUBLIC_APP_URL=https://makhzoon.me
# Public host that serves shareable receipts (/r/[orgSlug]/preview)
NEXT_PUBLIC_RECEIPT_URL=https://rcpt-app.makhzoon.me
NODE_ENV=production
# Explicit environment identifier. Values: development | staging | production
# Do NOT rely on NODE_ENV — Vercel sets NODE_ENV=production for Preview and Production.
NEXT_PUBLIC_APP_ENV=production

# --- Email (Resend) ---
# Production Resend API key, verified domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=Makhzoon <notifications@makhzoon.me>

# --- Cron ---
# Generate with: openssl rand -hex 32  (different value from dev and staging)
CRON_SECRET=

