# =============================================================================
# PRODUCTION ENVIRONMENT (main branch -> makhzoon.me)
# =============================================================================
# Paste this into Vercel:
#   Project: makhzoon-prod (or makhzoon)
#   Settings -> Environment Variables -> Import .env -> select "Production"
#     scope only
# Fill in the blanks before importing.
#
# WARNING: These values touch real customer data. Treat the filled-in version
# as a secret. Store it in a password manager, NOT a chat or repo.
# =============================================================================

# --- Firebase Client (public, safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=***REMOVED-LEAKED-FIREBASE-SECRET***
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=office-asset-system.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=office-asset-system
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=office-asset-system.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=655264017714
NEXT_PUBLIC_FIREBASE_APP_ID=1:655264017714:web:19f1180bb47069b05f7b2b

# --- Firebase Admin (server-side only, NEVER expose to client) ---
# From Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=office-asset-system
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@office-asset-system.iam.gserviceaccount.com
# Paste full key including BEGIN/END lines, keep \n as literal escapes, wrap in quotes
FIREBASE_PRIVATE_KEY=***REMOVED-LEAKED-FIREBASE-SECRET***
# --- Supabase (public, safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Admin (server-side only, NEVER expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- App Config ---
NEXT_PUBLIC_APP_URL=https://makhzoon.me
NODE_ENV=production
# Explicit environment identifier. Values: development | staging | production
# Do NOT rely on NODE_ENV — Vercel sets NODE_ENV=production for Preview and Production.
NEXT_PUBLIC_APP_ENV=production

# --- Email (Resend) ---
# Production Resend API key, verified domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=Makhzoon <notifications@makhzoon.me>

# --- Cron ---
# Generate with: openssl rand -hex 32  (different value from dev and staging)
CRON_SECRET=

